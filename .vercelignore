# NOTE: This file affects what gets uploaded to Vercel.
# The Vite build needs the theme source (src/themes/*) and static assets (public/theme/*)
# to produce a working /theme/landingpage bundle.

# Docs and server tests (not needed for build; scripts/ is required for build:api)
docs/
server/tests/

# Test and spec files
**/*.test.js
**/*.spec.js
**/*.test.ts
**/*.spec.ts

# Optional: ignore large runtime uploads (these should come from Blob on Vercel)
public/uploads/